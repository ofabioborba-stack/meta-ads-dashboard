# ─── Supabase ────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # anon / public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # service_role key (NUNCA exponha no frontend)

# ─── Tenant ──────────────────────────────────────────────────────────────────
# Slug do seu tenant — deve ser igual ao campo `slug` que você inseriu na tabela `tenants`
TENANT_SLUG=minha-agencia

# ─── Meta Ads API ────────────────────────────────────────────────────────────
# Crie em: developers.facebook.com → seu App → Ferramentas → Explorador de API
META_APP_ID=
META_APP_SECRET=
# Token de longa duração do sistema (gerado pelo App, não pessoal)
META_ACCESS_TOKEN=

# ─── Segurança dos endpoints de sync ─────────────────────────────────────────
# String aleatória — use a mesma no header Authorization do seu n8n
SYNC_SECRET=gere-uma-string-aleatoria-aqui
# Segredo do Vercel Cron (gerado automaticamente pelo Vercel ao criar um cron job)
CRON_SECRET=

# ─── Inteligência Artificial (Insights) ──────────────────────────────────────
# Chave da Anthropic para geração de insights por IA (opcional)
ANTHROPIC_API_KEY=

# ─── Evolution API (WhatsApp — opcional) ─────────────────────────────────────
# URL da sua instância da Evolution API
EVOLUTION_API_URL=https://api.seudominio.com
# Global API Key configurada na sua Evolution API
EVOLUTION_API_KEY=
# Nome da instância WhatsApp conectada
EVOLUTION_INSTANCE=
